# Dependencies
node_modules/
__pycache__/
.venv/
venv/
*.egg-info/

# Model + data caches (large, regenerable)
.hf-cache/
# The cache is named .nosync so iCloud Drive skips it: ~/Documents is synced,
# and uploading 2 GB of re-downloadable model weights blob by blob starves
# every other file operation in the folder (git included). Do not rename it
# back without moving the repo out of iCloud first.
.hf-cache.nosync/
artifacts/
*.safetensors

# Environment / secrets
.env
.env.*

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Experiment outputs (keep configs/metrics, ignore bulky artifacts)
experiments/**/runs/
experiments/**/checkpoints/
*.ckpt
*.pt
*.log
.claude/
.venv-lock-*.txt

# A run's own training log is part of the record when it sits in a gates
# directory beside that run's endpoint record. The blanket *.log rule above
# is why the control pilot's log was missing from the repository for a day
# (red-team ledger row RT-56, the missing training log). Records win.
!experiments/**/a3-gates/*.log

# The fifteen trained toy models behind the 2026-09-25 rehearsal repairs and
# the 2026-09-26 re-run under the version 3 rules. Arms C, F and M do not
# rebuild from code and seed, so these files are the record, not a cache.
# Committed by John's ruling of 2026-09-26 (pull request 62). Records win.
!experiments/rehearsal-successor-measure/out-repairs/models/*.pt
