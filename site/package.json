{
  "name": "minimum-viable-mind-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "export": "python3 ../scripts/export_site.py && python3 ../scripts/export_tracker.py",
    "check": "python3 ../scripts/export_site.py --check && python3 ../scripts/export_tracker.py --check",
    "predev": "npm run export",
    "dev": "astro dev",
    "prebuild": "npm run export",
    "build": "astro build && python3 ../scripts/check_site.py",
    "preview": "astro preview",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "astro": "^5.6.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
