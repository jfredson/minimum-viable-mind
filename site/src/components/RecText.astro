---
// Record text that may name another prediction by its id, as a reader's reason sometimes does
// ("belongs to a different prediction (gwt-offset)"). Each id is shown as a link to that
// prediction's page, labelled with its plain statement, so no bare id reaches a reader (reader
// check, 2026-11-21). The record's own words are kept; only the id is replaced.
import R from './R.astro';
import { tk } from '../lib/tracker';
interface Props { t: string }
// Prediction ids become a link to the prediction; source and study ids ("lamme-2018") become a
// short citation ("Lamme 2018"), linked where the record has an address (reader check,
// 2026-11-21). Only ids carrying a year are matched, so ordinary hyphenated words are left alone.
const refIds = Object.keys(tk.refs).filter((r) => /\d{4}/.test(r));
const ids = [...Object.keys(tk.predictions), ...refIds].sort((a, b) => b.length - a.length);
const re = new RegExp(`\\(?\\b(${ids.map((i) => i.replace(/[-]/g, '\\-')).join('|')})\\b\\)?`, 'g');
const parts: { text?: string; id?: string; paren?: boolean }[] = [];
let last = 0;
for (const m of Astro.props.t.matchAll(re)) {
  if (m.index! > last) parts.push({ text: Astro.props.t.slice(last, m.index) });
  parts.push({ id: m[1], paren: m[0].startsWith('(') && m[0].endsWith(')') });
  last = m.index! + m[0].length;
}
if (last < Astro.props.t.length) parts.push({ text: Astro.props.t.slice(last) });
---
{parts.map((p) => p.id && tk.predictions[p.id]
  ? <>{p.paren && '('}the prediction <a href={`/predictions/${p.id}/`}><R t={tk.predictions[p.id].statement} q /></a>{p.paren && ')'}</>
  : p.id
  ? <>{p.paren && '('}{tk.refs[p.id].url ? <a href={tk.refs[p.id].url}><R t={tk.refs[p.id].label} /></a> : <R t={tk.refs[p.id].label} />}{p.paren && ')'}</>
  : <R t={p.text} />)}
