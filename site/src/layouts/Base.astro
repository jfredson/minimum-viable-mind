---
import '../styles/global.css';
import '../styles/tracker.css';
import Nav from '../components/Nav.astro';
import { project, derived, fmtDate } from '../lib/project';

interface Props {
  title?: string;
  description?: string;
  // A tracker page (2026-11-21): every digit in its main column must come from the records
  // through the N and R components, which scripts/check_site.py enforces.
  strict?: boolean;
}

const {
  title = 'Minimum Viable Mind',
  // A short line for search results and link previews (2026-11-14); the record's own question is
  // a paragraph, too long for either.
  description = 'How far has the science of consciousness got in testing its theories? Each theory of consciousness is scored on how well published studies back it, how sharply it can be tested, and how much of it is still untested, by rules fixed in advance.',
  strict = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
// The social preview image (2026-11-14), made by scripts/social-image.mjs; an absolute address,
// as link previews need.
const socialImage = new URL('/social-preview.png', Astro.site).href;
const currentYear = new Date().getFullYear();
// "7 October 2026" for the footer; the design standard writes dates out there.
const longDate = fmtDate;
// Bump when the icon set changes, so browsers that keep their own copy of the icon (Safari above
// all) fetch the new one (2026-10-23, family-wide on John's word). The same tag is in
// public/site.webmanifest.
const iconVersion = '3';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Set the theme before first paint so there is no flash on load. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
    <meta id="theme-color-meta" name="theme-color" content="#f4f4f1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="John Andrew Fredrickson" />
    <link rel="author" href="https://johnandrewfredrickson.com/" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`/favicon.svg?v=${iconVersion}`} />
    <link rel="icon" type="image/png" sizes="32x32" href={`/favicon-32.png?v=${iconVersion}`} />
    <link rel="icon" type="image/png" sizes="16x16" href={`/favicon-16.png?v=${iconVersion}`} />
    <link rel="icon" href={`/favicon.ico?v=${iconVersion}`} sizes="any" />
    <link rel="apple-touch-icon" href={`/apple-touch-icon.png?v=${iconVersion}`} />
    <link rel="manifest" href={`/site.webmanifest?v=${iconVersion}`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Minimum Viable Mind" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Minimum Viable Mind: how the theories of consciousness are holding up. Every theory of consciousness, held to the same rules, this site's own included." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={socialImage} />
  </head>
  <body>
    {/* The Notebook skin's backdrop (ruled 2026-10-17): graph paper, drawn by the skin on this element; no sky. */}
    <div class="space-bg" aria-hidden="true"></div>
    <Nav />
    <main class="container" data-strict={strict ? "" : undefined}>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <span class="footer-brand">Minimum Viable Mind</span>
          <p class="footer-tag">Every theory of consciousness, held to the same rules, this site's own included.</p>
          <p class="footer-links">
            <a href="/about/">About</a>
            <a href="/about/#numbers">How the numbers are worked out</a>
            <a href="/about/#reading">This week's reading</a>
            <a href="/about/#disagree">Disagree with something</a>
            <a href="/tests/">Our own tests</a>
            <a href="/story/">The project's story</a>
            <a href="https://github.com/jfredson/minimum-viable-mind" rel="noopener">Source</a>
            <a href="https://x.com/SentHorizons" rel="noopener">Follow on X</a>
          </p>
          <p class="footer-meta">
            © {currentYear} <a href="https://johnandrewfredrickson.com/" rel="author">John Andrew Fredrickson</a>. Last built {longDate(derived.exported_on)}{derived.commit ? ` (version ${derived.commit})` : ''} from the records. Free to reuse with credit (<a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>); code under the MIT licence. Please credit as: <cite>Minimum Viable Mind</cite>, by John Andrew Fredrickson, a Sentient Horizons project, <a href="https://minimumviablemind.sentient-horizons.com/">minimumviablemind.sentient-horizons.com</a>.
          </p>
          <p class="footer-parent"><a href="https://sentient-horizons.com/projects/" rel="noopener">A Sentient Horizons project.</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
