---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import { project, derived, fmtDate } from '../lib/project';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Minimum Viable Mind',
  description = project.question,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const currentYear = new Date().getFullYear();
// "7 October 2026" for the footer; the design standard writes dates out there.
const longDate = (iso: string) => {
  const [y, m, d] = iso.split('-').map(Number);
  return new Date(Date.UTC(y, m - 1, d)).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Set the theme before first paint so there is no flash on load. */}
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
        } catch (e) {}
      })();
    </script>
    <meta id="theme-color-meta" name="theme-color" content="#f4f4f1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="John Fredrickson" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Minimum Viable Mind" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    {/* The Notebook skin's backdrop (ruled 2026-10-17): graph paper, drawn by the skin on this element; no sky. */}
    <div class="space-bg" aria-hidden="true"></div>
    <Nav />
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container footer-grid">
        <div>
          <span class="footer-brand">Minimum Viable Mind</span>
          <p class="footer-tag">A build-and-measure project downstream of Sentient Horizons and The Calibration Problem.</p>
          <p class="footer-links">
            <a href="/">Where we are</a>
            <a href="/eli5/">Explain it simply</a>
            <a href="/ladder/">The ladder</a>
            <a href="/questions/">Questions and ideas</a>
            <a href="/learned/">What we have learned</a>
            <a href="/story/">The story so far</a>
          </p>
          <p class="footer-meta">
            © {currentYear} John Fredrickson. Last built {longDate(derived.exported_on)}{derived.commit ? ` (version ${derived.commit})` : ''} from the project record as of {longDate(project.updated_on)}. Free to reuse with credit (<a href="https://creativecommons.org/licenses/by/4.0/" rel="license">CC BY 4.0</a>); code under the MIT licence.
          </p>
          <p class="footer-parent"><a href="https://sentient-horizons.com/projects/" rel="noopener">A Sentient Horizons project.</a></p>
        </div>
      </div>
    </footer>
  </body>
</html>
