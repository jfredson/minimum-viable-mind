---
// A theory's page (design proposal section 4, pictures 8 to 10; tracker pattern rule 2.2): the
// plain name and paragraph, the three scores with what each rests on, the tie note, its core
// claims as dots, its predictions with their states, and on the right what would move it. One
// page per scored theory in the records; the scoring work's later records add pages with no
// change here.
import Base from '../../layouts/Base.astro';
import Bar from '../../components/Bar.astro';
import N from '../../components/N.astro';
import R from '../../components/R.astro';
import StateBadge from '../../components/StateBadge.astro';
import VerifyNote from '../../components/VerifyNote.astro';
import WaitingLine from '../../components/WaitingLine.astro';
import { tk, pred, dotClass, word, groupTitle, HALF_REASON, type Theory } from '../../lib/tracker';

export function getStaticPaths() {
  return Object.values(tk.theories).map((t) => ({ params: { id: t.id } }));
}
const t = tk.theories[Astro.params.id as string] as Theory;
const preds = t.predictions.map(pred);
const sharp = preds.filter((p) => p.separates);
const shared = preds.filter((p) => !p.separates);
const claimNo = (cid: string) => t.claims.findIndex((c) => c.id === cid) + 1;
// the first prediction row for each main claim carries the anchor the claim list links to
const anchored = new Set<string>();
const anchorFor = (cid: string) => (anchored.has(cid) ? undefined : (anchored.add(cid), `c-${cid}`));
const groupLine = groupTitle(t.group).toLowerCase();
const supWords = t.support === null ? null : t.support > tk.rules.even ? 'Leans supported.' : t.support < tk.rules.even ? 'Leans against.' : 'Even.';
---

<Base title={`${t.name} · Minimum Viable Mind`} description={`How ${t.name.charAt(0).toLowerCase() + t.name.slice(1)} is holding up against published studies: its main claims, its predictions and how the tests have gone.`} strict>
  <div class="page two">
    <div>
      <p class="crumbs"><a href="/theories/">Theories</a> / {t.name}</p>
      <p class="eyebrow">A theory of consciousness{t.own && <> · this site's own</>} · {groupLine}{t.tied.length > 0 && <> · too close to separate from {t.tied.map((x, i) => <>{i > 0 && ' and '}{x.with_name.charAt(0).toLowerCase() + x.with_name.slice(1)}</>)}</>}</p>
      <h1>{t.name}</h1>
      <R as="p" class="tplain" t={t.plain} />
      {tk.links.theories[t.id] && <p class="meta">More about it: <a href={tk.links.theories[t.id]}>{tk.links.person_pages.includes(t.id) ? 'its proponent\'s encyclopaedia article' : 'its encyclopaedia article'}</a>.</p>}
      {t.proponents.length > 0 && <p class="meta">{t.own ? 'Its author:' : 'Among its proponents:'} {t.proponents.map((n, i) => <>{i > 0 && ', '}{tk.links.people[n] ? <a href={tk.links.people[n]}>{n}</a> : n}</>)}.</p>}
      <VerifyNote ids={t.verify_open} />

      <div class="scores" data-record={t.id}>
        <div class="score">
          <div class="lab">How well studies back it</div>
          {t.support === null ? <div class="num">none</div> : <div class="num"><N v={t.support} /> <small>/ <N v={tk.rules.scale_top} /></small></div>}
          <p>
            {t.support === null
              ? <>No support score yet: it needs counted studies from at least <N v={tk.rules.groups_needed} t={word(tk.rules.groups_needed)} /> separate research groups, and has {t.rests_on.groups === 0 ? 'none' : <><N v={t.rests_on.groups} t={word(t.rests_on.groups)} /></>}.</>
              : <>{supWords}{' '}<N v={t.rests_on.studies} /> {t.rests_on.studies === 1 ? 'study' : 'studies'} from <N v={t.rests_on.groups} /> groups, <N v={t.rests_on.outcomes} /> counted results, total weight <N v={t.rests_on.total_weight} />. <N v={tk.rules.even} /> would mean even.</>}
          </p>
          <Bar kind="sup" v={t.support} label="backed" num={false} />
        </div>
        <div class="score">
          <div class="lab">How clearly it can be tested</div>
          <div class="num"><N v={t.testability} /> <small>/ <N v={tk.rules.scale_top} /></small></div>
          <p><N v={t.claims_sharp} /> of <N v={t.claims_count} /> main claims {t.claims_sharp === 1 ? 'comes' : 'come'} with a prediction that could fail and that no rival theory's own published work predicts too. {t.past_bar ? (t.group === 'ranked'
              ? <>That is more than half; with counted studies from <N v={tk.rules.groups_needed} t={word(tk.rules.groups_needed)} /> or more separate research groups, it is ranked.</>
              : <>That is more than half, but it does not yet have counted studies from <N v={tk.rules.groups_needed} t={word(tk.rules.groups_needed)} /> separate research groups, so it is {groupTitle(t.group).toLowerCase()}.</>) : <>That is half or fewer, so it is {groupTitle(t.group).toLowerCase()}: <N v={t.claims_needed_more} t={word(t.claims_needed_more)} /> more need such a prediction.</>}</p>
          <Bar kind="test" v={t.testability} label="clear" num={false} />
        </div>
        <div class="score">
          <div class="lab">How much is still untested</div>
          <div class="num"><N v={t.left_to_test} /> <small>/ <N v={tk.rules.scale_top} /></small></div>
          <p>It could be tested in <N v={t.left_counts.total} /> places: each prediction that sets it apart from a rival{t.left_counts.placeholders > 0 && <>, plus one for each main claim that has no such prediction yet (<N v={t.left_counts.placeholders} t={word(t.left_counts.placeholders)} /> here)</>}. No counted study has touched <N v={t.left_counts.untested} /> of them.</p>
          <Bar kind="left" v={t.left_to_test} label="untested" num={false} />
        </div>
      </div>
      {t.leans_against && <p class="meta">The evidence so far leans against it. It keeps its place in the ranking.</p>}
      {t.tied.map((x, i) => (
        <p class="meta" id={i === 0 ? 'tie' : undefined}>Too close to separate from <a href={`/theories/${x.with}/`}>{x.with_name}</a>, its neighbour in the ranking: if one study, <R t={x.study_name} />, had gone the other way, the two would swap places or draw level, so neither is shown ahead. To check it by hand, turn that study's results round in both theories' predictions and work both support scores again by the formula on <a href="/about/#numbers">About</a>.</p>
      ))}

      <div class="shead"><h2>Its main claims</h2><span>quoted from {t.claims_from?.url ? <a href={t.claims_from.url}><R t={t.claims_from.citation} /></a> : <R t={t.claims_from?.citation} />}, fixed on <N v={t.fixed_on} t={t.fixed_on_long} /> until the yearly review</span></div>
      <ul class="claims">
        {t.claims.map((c, i) => (
          <li data-record={c.id} id={`claim-${c.id}`}>
            <span class={`dot ${dotClass(c.level)}`} aria-label={c.level >= 1 ? 'a full point' : c.level > 0 ? 'half a point' : 'none yet'}></span>
            <span>
              <span class="m">Main claim <N v={i + 1} /></span>
              <R t={c.quote} q class="q" />
              <span class="m">{c.level >= 1 ? 'a prediction stated by its proponents could fail, and no rival theory\'s own published work predicts it too' : c.level > 0 ? `half a point: its best prediction could fail and no rival theory's own published work predicts it too, but ${c.half_reasons.map((h) => HALF_REASON[h]).join('; and ')}` : 'no prediction yet that could fail and that no rival theory\'s own published work predicts too'}</span>
            </span>
            <span>{c.predictions.length ? <a href={`#c-${c.id}`}><N v={c.predictions.length} /> {c.predictions.length === 1 ? 'prediction' : 'predictions'}</a> : 'none'}</span>
          </li>
        ))}
      </ul>
      <p class="key"><span><span class="dot full"></span> a full point</span><span><span class="dot half"></span> half a point, for the reason given</span><span><span class="dot"></span> none yet</span></p>

      <div class="shead"><h2>Its predictions</h2><span>the ones that set it apart from a rival; those that do not are listed after them and score nothing</span></div>
      <table class="preds">
        <thead><tr><th>Prediction</th><th class="hide-s">Who says so</th><th>State</th><th class="hide-s">Counted studies</th></tr></thead>
        <tbody>
          {[...sharp, ...shared].map((p) => (
            <tr data-record={p.id} id={anchorFor(p.core_claim)}>
              <td><a href={`/predictions/${p.id}/`}><R t={p.statement} /></a><span class="m">tied to main claim <N v={claimNo(p.core_claim)} />{p.core_claim ? ', so its results count double' : ''}{!p.separates && ' · sets it apart from no rival on the record'}{p.verify_open.length > 0 && ' · still being checked'}</span></td>
              <td class="hide-s">{p.stated_by === 'proponent' ? 'its proponents' : 'inferred here'}</td>
              <td><StateBadge s={p.state} /></td>
              <td class="hide-s"><N v={p.counted_count} /></td>
            </tr>
          ))}
        </tbody>
      </table>
      {t.explained_afterwards.length > 0 && (
        <p class="meta">Also listed, moving no score: {t.explained_afterwards.map((e, i) => <>{i > 0 && '; '}<a href={`/predictions/${e.prediction}/`}><R t={e.name} /></a></>)}, explained afterwards and not counted (the prediction was not on record before the study's data).</p>
      )}
    </div>

    <aside class="side">
      <div class="box tmove">
        <h3>What would move this</h3>
        <ul>
          {t.move.map((m) => (
            m.kind === 'claim' ? (
              <li>A prediction from its proponents that could fail, and that no rival theory's own published work predicts too, for <a href={`#claim-${m.claim}`}>main claim <N v={t.claims.findIndex((c) => c.id === m.claim) + 1} /></a> in the list: how clearly it can be tested, <b><N v={m.from} /> → <N v={m.to} /></b>.</li>
            ) : m.kind === 'probe' ? (
              <li>A study registered in advance and run by an outside group (weight <N v={m.weight} />), on <a href={`/predictions/${m.prediction}/`}><R t={m.statement} /></a>{m.from === null || m.from === undefined
                ? <> would give it a support score for the first time: <b><N v={m.for} /></b> if it came out for, <b><N v={m.against} /></b> against.</>
                : <> support <b><N v={m.from} /> → <N v={m.for} /></b> if it came out for, <b><N v={m.from} /> → <N v={m.against} /></b> against.</>}</li>
            ) : (
              <li>Counted studies from <N v={m.groups_needed} t={word(m.groups_needed ?? 0)} /> separate research groups, on the prediction <a href={`/predictions/${m.prediction}/`}><R t={m.statement} q /></a> or on its other predictions, would give it a support score for the first time; it has studies from {m.groups === 0 ? 'none' : <N v={m.groups} t={word(m.groups ?? 0)} />} so far.</li>
            )
          ))}
        </ul>
        <p>Worked out by the same rules as the scores, for one study at a time.</p>
      </div>
      <div class="box">
        <h3>How well studies back it, run by run</h3>
        <p>First scored on <N v={t.first_scored} t={t.first_scored_long ?? ""} />. Every later change will be drawn here, run by run, with a dated entry in the story so far.</p>
      </div>
      <div class="box">
        <h3>Last readings</h3>
        <p><WaitingLine theory={t.id} /> <a href="/about/#reading">About the weekly reading</a>.</p>
      </div>
      <p class="disagree"><a href={`https://github.com/jfredson/minimum-viable-mind/issues/new?title=${encodeURIComponent(`Disagree: ${t.name}`)}`} rel="noopener">Disagree with something on this page</a></p>
    </aside>
  </div>
</Base>
