---
import Base from '../layouts/Base.astro';
import Status from '../components/Status.astro';
import Meter from '../components/Meter.astro';
import { data, project, derived, fmtDate, usd, label } from '../lib/project';
import { prose } from '../lib/prose';

const a3 = data.spend.lines[0];
const steps = data.next_steps.filter((n) => n.status !== 'done');
const decisions = steps.filter((n) => n.decision);
const work = steps.filter((n) => !n.decision).slice(0, 4);
const openIdeas = data.ideas.filter((i) => i.status === 'on-the-table' || i.status === 'authorised');
const latest = data.timeline[0];
const wrapDays = derived.days_to_wrap_up;
// The trunk above the opening paragraph (2026-10-16): one number a stranger can hold, the count
// of delivered stages on the project's ladder, with the stage names as its claim. Drawn from the
// stage list in data/project.toml, never typed in.
const delivered = data.stages.filter((s) => s.status === 'delivered');
const deliveredNames = delivered.map((s) => s.name.charAt(0).toLowerCase() + s.name.slice(1));
const joined = deliveredNames.length > 1
  ? `${deliveredNames.slice(0, -1).join(', ')} and ${deliveredNames[deliveredNames.length - 1]}`
  : deliveredNames.join('');
---

<Base>
  <section class="home-hero mvm-hero">
    <div>
      <p class="eyebrow">Where we are · updated {fmtDate(project.updated_on)}</p>
      <p class="big-number">{delivered.length}<small>of {data.stages.length}</small></p>
      <h1 class="big-claim">Stages of the project's ladder delivered so far: {joined}.</h1>
      <p class="prose hero-prose"><Fragment set:html={prose(project.where_we_are)} /></p>
      <p class="prose hero-prose dim"><Fragment set:html={prose(project.where_we_are_going)} /></p>
      <div class="ctas">
        <a class="btn" href="#next">The next most valuable steps</a>
        <a class="btn btn-ghost" href="/learned/">What we have learned</a>
        <a class="btn btn-ghost" href="/eli5/">Explain it simply</a>
      </div>
    </div>
    <aside class="dial">
      <div class="dial-head"><span class="dial-label">At a glance</span><span class="dial-hint">as of <span data-today>{fmtDate(derived.exported_on)}</span></span></div>
      <div class="dial-stats dial-stats-2">
        <div data-countdown={project.wrap_up_start}><div class="stat" data-days>{wrapDays > 0 ? wrapDays : '0'}</div><div class="stat-label" data-words>{wrapDays > 0 ? `days until wrap-up starts (${fmtDate(project.wrap_up_start)}): nothing new launches after it` : `wrap-up started ${fmtDate(project.wrap_up_start)}: nothing new launches now`}</div></div>
        <div><div class="stat">{derived.counts.findings}</div><div class="stat-label">findings on record</div></div>
        <div><div class="stat">{derived.counts.decisions_pending}</div><div class="stat-label">decisions waiting on me</div></div>
        <div><div class="stat">{usd(a3.spent)}<span class="stat-of"> / {usd(a3.cap)}</span></div><div class="stat-label">{a3.name}</div></div>
      </div>
      <div>
        <p class="dial-note">Latest entry, {fmtDate(latest.date)}: {latest.title}.</p>
        <Meter value={derived.stage_progress_mean} caption={`Ladder progress, mean across the eight stages: ${derived.stage_progress_mean}%`} small />
      </div>
    </aside>
    {/* The countdown is worked out again in the reader's browser, on the Pacific date, so it stays
        right between builds; the number above is the build day's, for a reader without scripts. */}
    <script is:inline>
      (function () {
        try {
          var today = new Intl.DateTimeFormat('en-CA', { timeZone: 'America/Los_Angeles' }).format(new Date());
          var t = Date.UTC(+today.slice(0, 4), +today.slice(5, 7) - 1, +today.slice(8, 10));
          var fmt = function (ms) { return new Date(ms).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' }); };
          document.querySelectorAll('[data-today]').forEach(function (el) { el.textContent = fmt(t); });
          document.querySelectorAll('[data-countdown]').forEach(function (el) {
            var d = el.getAttribute('data-countdown');
            var target = Date.UTC(+d.slice(0, 4), +d.slice(5, 7) - 1, +d.slice(8, 10));
            var days = Math.round((target - t) / 86400000);
            el.querySelector('[data-days]').textContent = days > 0 ? days : '0';
            el.querySelector('[data-words]').textContent = days > 0
              ? 'days until wrap-up starts (' + fmt(target) + '): nothing new launches after it'
              : 'wrap-up started ' + fmt(target) + ': nothing new launches now';
          });
        } catch (e) {}
      })();
    </script>
  </section>

  <section class="section" id="next">
    <div class="shead"><h2>The next most valuable steps</h2><span class="dim">and what each can teach us</span></div>
    <div class="steps">
      {work.map((n) => (
        <article class="step">
          <div class="step-top"><span class="mono">{n.id}</span><Status value={n.status} /></div>
          <h3 class="step-title"><Fragment set:html={prose(n.title)} /></h3>
          <p class="step-teach"><Fragment set:html={prose(n.teaches)} /></p>
          <p class="step-meta"><Fragment set:html={prose(n.when)} /> · <Fragment set:html={prose(n.owner)} /> · <Fragment set:html={prose(n.cost)} /></p>
        </article>
      ))}
    </div>
    {decisions.length > 0 && (
      <div class="callout decisions">
        <p class="kicker" style="margin-top:0">Waiting on me</p>
        <ol class="decision-list">
          {decisions.map((n) => (
            <li>
              <strong><Fragment set:html={prose(n.title)} /></strong> <span class="dim">(<Fragment set:html={prose(n.when)} />)</span>
              <div class="decision-teach"><Fragment set:html={prose(n.teaches)} /></div>
            </li>
          ))}
        </ol>
      </div>
    )}
  </section>

  <section class="section">
    <div class="shead"><h2>The question</h2></div>
    <p class="prose narrow"><Fragment set:html={prose(project.question)} /></p>
    <p class="prose narrow dim"><Fragment set:html={prose(project.one_line)} /></p>
    <p class="prose narrow dim">The experiments are built and run by Claude, an AI model made by Anthropic, under written rules. Some of the models being tested are Claude models too, so the bar each experiment has to clear is set by me before it runs, along with the result that would count against it.</p>
  </section>

  <section class="section">
    <div class="shead"><h2><Fragment set:html={prose(data.wager.title)} /></h2><span class="dim">the presupposition, not a hypothesis</span></div>
    <div class="wager">
      <p class="prose wager-claim"><Fragment set:html={prose(data.wager.claim)} /></p>
      <div class="wager-cols">
        <p><span class="kicker-inline">Its status</span> <Fragment set:html={prose(data.wager.status_note)} /></p>
        <p><span class="kicker-inline">Why still never a verdict</span> <Fragment set:html={prose(data.wager.why_no_verdict)} /></p>
      </div>
      <p class="dim wager-src"><Fragment set:html={prose(data.wager.source)} /></p>
    </div>
  </section>

  <section class="section">
    <div class="shead"><h2>Three nested goals</h2><span class="dim">kept separate so expectations stay honest</span></div>
    <div class="moves">
      {data.goals.map((g) => (
        <article class="move">
          <div class="step-top"><span class="mono">{g.id}</span><Status value={g.status} /></div>
          <h3 class="move-title"><Fragment set:html={prose(g.title)} /></h3>
          <p class="move-body"><Fragment set:html={prose(g.summary)} /></p>
          <p class="move-evidence"><span class="kicker-inline">Where it stands</span> <Fragment set:html={prose(g.evidence)} /></p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="shead"><h2>The ladder</h2><a class="dim" href="/ladder/">every stage in detail →</a></div>
    <ol class="ladder-strip">
      {data.stages.map((s) => (
        <li>
          <a class="rung" href={`/ladder/#stage-${s.id}`}>
            <span class="rung-top"><span class="mono">Stage {s.id}</span><Status value={s.status} /></span>
            <span class="rung-name">{s.name}</span>
            <Meter value={s.progress} caption={`${s.progress}%`} small />
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section class="section">
    <div class="shead"><h2>On the table right now</h2><a class="dim" href="/questions/">all questions and ideas →</a></div>
    <ul class="idea-list">
      {openIdeas.map((i) => (
        <li class="idea">
          <div class="step-top"><span class="mono">{i.id} · Stage {i.stage}</span><Status value={i.status} /></div>
          <h3 class="idea-title"><Fragment set:html={prose(i.title)} /></h3>
          <p class="idea-teach"><Fragment set:html={prose(i.teaches)} /></p>
          <p class="step-meta"><Fragment set:html={prose(i.cost)} /> · <Fragment set:html={prose(i.gate)} /></p>
        </li>
      ))}
    </ul>
  </section>
</Base>
